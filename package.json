    "test:memory": "node script/test-native-memory.js",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "node-addon-api": "^8.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "jasmine": "^7.0.0",
    "node-gyp": "^13.1.0",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "eslint@^10.14.0": {
      "minimatch": "11.0.4"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.4"
    },
    "jasmine@^7.0.0": {
      "glob": "14.0.3"
    }
  }
