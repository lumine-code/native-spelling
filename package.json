{
  "name": "@lumine-code/native-spelling",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Provides native system and Hunspell dictionary bindings.",
  "main": "./lib/spellchecker.js",
  "repository": "https://github.com/lumine-code/native-spelling",
  "bugs": "https://github.com/lumine-code/native-spelling/issues",
  "homepage": "https://github.com/lumine-code/native-spelling",
  "license": "MIT",
  "gypfile": true,
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "spelling",
    "hunspell",
    "dictionary",
    "native-addon",
    "node-api"
  ],
  "files": [
    "binding.gyp",
    "lib",
    "script",
    "spec",
    "src",
    "vendor",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "build": "node-gyp rebuild",
